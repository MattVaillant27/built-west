---
import '@fontsource/montserrat/400.css';
import '@fontsource/montserrat/500.css';
import '@fontsource/montserrat/600.css';
import '@fontsource/montserrat/700.css';
import '@fontsource-variable/source-serif-4/opsz.css';
import '../styles/global.css';

interface Props {
  title: string;
  bare?: boolean; // login page: no navigation
}
const { title, bare = false } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/crm';
const nav = [
  { label: 'Today', href: '/crm' },
  { label: 'Guests', href: '/crm/guests' },
  { label: 'Sponsors', href: '/crm/sponsors' },
  { label: 'Partners', href: '/crm/partners' },
  { label: 'Settings', href: '/crm/settings' },
];
const active = (href: string) => (href === '/crm' ? path === '/crm' : path.startsWith(href));
---

<!doctype html>
<html lang="en-CA">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} · Built West CRM</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#0B1F2D" />
  </head>
  <body class="crm">
    <header class="crm-bar navy">
      <div class="crm-wrap bar-inner">
        <a class="crm-brand" href="/crm"><span class="serif">Built West</span> <span class="eyebrow">CRM</span></a>
        {!bare && <a class="btn btn--inv btn--sm" href="/crm/new">+ New</a>}
      </div>
      {!bare && (
        <nav class="crm-wrap crm-nav" aria-label="CRM">
          {nav.map((n) => <a href={n.href} aria-current={active(n.href) ? 'page' : undefined}>{n.label}</a>)}
        </nav>
      )}
    </header>
    <main class="crm-wrap crm-main">
      <slot />
    </main>
    <script>
      // Stage selects submit on change; confirm destructive actions.
      document.querySelectorAll<HTMLSelectElement>('select[data-autosubmit]').forEach((s) =>
        s.addEventListener('change', () => s.form?.requestSubmit()),
      );
      document.querySelectorAll<HTMLFormElement>('form[data-confirm]').forEach((f) =>
        f.addEventListener('submit', (e) => { if (!confirm(f.dataset.confirm)) e.preventDefault(); }),
      );
    </script>
  </body>
</html>

<style is:global>
  .crm { font-size: 16px; }
  .crm-wrap { width: 100%; max-width: 1320px; margin: 0 auto; padding: 0 var(--pad); }
  .crm-bar { position: sticky; top: 0; z-index: 20; }
  .bar-inner { display: flex; align-items: center; justify-content: space-between; height: 60px; }
  .crm-brand { text-decoration: none; display: flex; align-items: baseline; gap: 10px; }
  .crm-brand .serif { font-size: 22px; font-weight: 700; }
  .crm-nav { display: flex; gap: 4px; overflow-x: auto; scrollbar-width: none; }
  .crm-nav a { flex: none; padding: 10px 14px 12px; font: 600 14px var(--font-sans); text-decoration: none; color: var(--white-70); border-bottom: 3px solid transparent; }
  .crm-nav a:hover { color: var(--white); }
  .crm-nav a[aria-current='page'] { color: var(--white); border-bottom-color: var(--orange); }
  .crm-main { padding-top: 28px; padding-bottom: 80px; }

  .btn--sm { height: 38px; padding: 0 14px; font-size: 12px; }
  .btn--quiet { background: transparent; color: var(--navy); box-shadow: inset 0 0 0 1px var(--navy-15); }
  .btn--quiet:hover { background: var(--navy-08); }
  .btn--danger { background: transparent; color: #9c2f0c; box-shadow: inset 0 0 0 1px rgba(156, 47, 12, 0.35); }

  .crm h1 { font-size: clamp(28px, 4vw, 40px); line-height: 1.1; }
  .crm h2.section-title { font: 600 12px var(--font-sans); letter-spacing: 0.2em; text-transform: uppercase; color: var(--coastal); margin: 32px 0 12px; }
  .page-head { display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between; gap: 16px; margin-bottom: 20px; }
  .muted { color: var(--coastal); font-size: 14px; }
  .flash { background: var(--card); border-left: 3px solid var(--orange); padding: 12px 16px; margin-bottom: 20px; }
  .empty-note { color: var(--coastal); padding: 16px 0; }

  /* Record rows */
  .rows { list-style: none; padding: 0; border-top: 1px solid var(--navy-15); }
  .rows li { border-bottom: 1px solid var(--navy-15); }
  .row-link { display: grid; grid-template-columns: 1fr auto; gap: 4px 16px; padding: 14px 4px; text-decoration: none; }
  .row-link:hover { background: var(--navy-08); }
  .row-link strong { font-weight: 600; }
  .row-meta { font-size: 13px; color: var(--coastal); }
  .row-side { font-size: 13px; color: var(--coastal); text-align: right; }
  .overdue { color: #9c2f0c; font-weight: 600; }
  .tag { display: inline-block; font: 600 11px var(--font-sans); letter-spacing: 0.08em; text-transform: uppercase; padding: 3px 8px; border-radius: 2px; background: var(--navy-08); color: var(--navy); }

  /* Pipeline board */
  .board { display: grid; grid-auto-flow: column; grid-auto-columns: minmax(240px, 1fr); gap: 12px; overflow-x: auto; padding-bottom: 12px; }
  .col { background: rgba(11, 31, 45, 0.04); border-radius: 4px; padding: 12px; min-height: 120px; }
  .col-head { display: flex; justify-content: space-between; font: 600 12px var(--font-sans); letter-spacing: 0.14em; text-transform: uppercase; margin-bottom: 10px; }
  .deal { background: var(--card); border: 1px solid var(--navy-08); border-radius: 4px; padding: 12px; margin-bottom: 8px; }
  .deal a { text-decoration: none; font-weight: 600; display: block; }
  .deal .row-meta { margin: 2px 0 8px; }
  .deal select { width: 100%; font-size: 13px; padding: 6px; border: 1px solid var(--navy-15); border-radius: 2px; background: #fff; }

  /* Forms */
  .crm .field { margin-bottom: 20px; }
  .crm .field input, .crm .field select, .crm .field textarea { font-size: 16px; }
  .crm .field select { width: 100%; background: transparent; border: 0; border-bottom: 1.5px solid currentColor; padding: 10px 2px; border-radius: 0; }
  .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 0 24px; }
  .actions { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; }

  .detail { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 40px; align-items: start; }
  .note { padding: 14px 0; border-top: 1px solid var(--navy-15); }
  .note p { white-space: pre-wrap; }
  .note time { font-size: 12px; color: var(--coastal); }

  @media (max-width: 899px) {
    .detail { grid-template-columns: 1fr; }
    .grid-2 { grid-template-columns: 1fr; }
    .board { grid-auto-flow: row; grid-auto-columns: auto; overflow: visible; }
    .col { min-height: 0; }
  }
</style>

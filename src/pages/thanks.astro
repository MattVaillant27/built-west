---
// Fallback confirmation for form posts when JavaScript is off.
import Base from '../layouts/Base.astro';
---

<Base title="Thanks" noindex>
  <section class="section">
    <div class="wrap">
      <p class="eyebrow">Received</p>
      <h1 class="h1">Thanks.</h1>
      <p class="lede">We’ve got your message. If you signed up for updates, we’ll keep you posted.</p>
      <p style="margin-top:32px"><a class="btn" href="/">Back to home <span class="arrow" aria-hidden="true"></span></a></p>
    </div>
  </section>
</Base>

<style>
  h1 { margin: 20px 0 24px; }
</style>

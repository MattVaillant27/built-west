---
import Crm from '../../layouts/Crm.astro';
import Csrf from '../../components/crm/Csrf.astro';
import RecordRow from '../../components/crm/RecordRow.astro';
import { FIELDS, KINDS, STAGES, type Kind } from '../../crm/config';
import { readPost } from '../../crm/request';
import { formatDay, getRecord, listRecords, saveRecord, subtitle, today } from '../../crm/store';

export const prerender = false;

const kind = (Object.keys(KINDS) as Kind[]).find((k) => KINDS[k].path === `/crm/${Astro.params.list}`);
if (!kind) return new Response('Not found', { status: 404 });

// Stage change from the board.
if (Astro.request.method === 'POST') {
  const form = await readPost(Astro);
  if (!form) return new Response('Forbidden', { status: 403 });
  const r = await getRecord(String(form.get('id')));
  const stage = String(form.get('stage'));
  if (r && r.kind === kind && STAGES[kind]?.includes(stage)) {
    r.stage = stage;
    await saveRecord(r);
  }
  return Astro.redirect(Astro.url.pathname + Astro.url.search, 303);
}

const q = (Astro.url.searchParams.get('q') ?? '').trim().toLowerCase();
const showArchived = Astro.url.searchParams.has('archived');
const all = await listRecords(kind, { includeArchived: showArchived });
const filterFields = FIELDS[kind].filter((f) => f.filter);
const active = filterFields
  .map((f) => ({ key: f.key, value: Astro.url.searchParams.get(f.key) ?? '' }))
  .filter((a) => a.value);
const records = all
  .filter((r) => !q || [r.name, r.stage, ...Object.values(r.fields)].join(' ').toLowerCase().includes(q))
  .filter((r) => active.every((a) => r.fields[a.key] === a.value));
const stages = STAGES[kind];
const now = today();
const meta = KINDS[kind];
---

<Crm title={meta.plural}>
  <div class="page-head">
    <div>
      <p class="eyebrow eyebrow--muted">{stages ? 'Pipeline' : 'Contacts'}</p>
      <h1>{meta.plural}</h1>
    </div>
    <div class="actions">
      <form method="GET" class="search" id="filters">
        <label class="sr-only" for="q">Search {meta.plural.toLowerCase()}</label>
        <input id="q" name="q" type="search" value={q} placeholder={`Search ${meta.plural.toLowerCase()}`} />
        {showArchived && <input type="hidden" name="archived" value="1" />}
      </form>
      <a class="btn btn--sm" href={`/crm/new?kind=${kind}`}>+ Add {meta.label.toLowerCase()}</a>
    </div>
  </div>

  {filterFields.length > 0 && (
    <div class="filters">
      {filterFields.map((f) => (
        <label>
          <span class="sr-only">{f.label}</span>
          <select name={f.key} form="filters" data-autosubmit class:list={{ on: active.some((a) => a.key === f.key) }}>
            <option value="">{f.label}: all</option>
            {f.options!.map((o) => <option selected={Astro.url.searchParams.get(f.key) === o}>{o}</option>)}
          </select>
        </label>
      ))}
      {(active.length > 0 || q) && <a class="link" href={meta.path}>Clear</a>}
      <span class="muted">{records.length} shown</span>
    </div>
  )}

  {stages ? (
    <div class="board">
      {stages.map((stage) => {
        const inStage = records.filter((r) => r.stage === stage);
        return (
          <section class="col" aria-label={stage}>
            <div class="col-head"><span>{stage}</span><span>{inStage.length}</span></div>
            {inStage.map((r) => {
              const due = r.followUp?.date;
              return (
                <div class="deal">
                  <a href={`/crm/r/${r.id}`}>{r.name}</a>
                  <p class="row-meta">
                    {subtitle(r) || '—'}
                    {r.kind === 'sponsor' && r.fields.value && <span> · ${Number(r.fields.value).toLocaleString('en-CA')}</span>}
                    {due && <span class:list={['due', { overdue: due < now }]}><br />Follow up {formatDay(due)}</span>}
                  </p>
                  {r.kind === 'guest' && (
                    <p class="chips">
                      {[r.fields.profile, r.fields.warmth, r.fields.timing, r.fields.tags?.split(',').map((t) => t.trim()).includes('Woman') ? 'Woman' : '']
                        .filter(Boolean)
                        .map((t) => <span class="tag">{t}</span>)}
                    </p>
                  )}
                  <form method="POST">
                    <Csrf />
                    <input type="hidden" name="id" value={r.id} />
                    <label class="sr-only" for={`stage-${r.id}`}>Stage for {r.name}</label>
                    <select id={`stage-${r.id}`} name="stage" data-autosubmit>
                      {stages.map((s) => <option selected={s === r.stage}>{s}</option>)}
                    </select>
                    <noscript><button class="btn btn--sm btn--quiet" type="submit">Move</button></noscript>
                  </form>
                </div>
              );
            })}
          </section>
        );
      })}
    </div>
  ) : records.length ? (
    <ul class="rows">{records.map((r) => <RecordRow record={r} />)}</ul>
  ) : (
    <p class="empty-note">{q ? 'No matches.' : `No ${meta.plural.toLowerCase()} yet.`}</p>
  )}

  <p class="muted archived-toggle">
    {showArchived ? <a class="link" href={meta.path}>Hide archived</a> : <a class="link" href={`${meta.path}?archived=1`}>Show archived</a>}
  </p>
</Crm>

<style>
  .search input { height: 38px; width: min(260px, 60vw); padding: 0 12px; border: 1px solid var(--navy-15); border-radius: 2px; background: #fff; font-size: 15px; }
  .archived-toggle { margin-top: 24px; }
  .chips { display: flex; flex-wrap: wrap; gap: 4px; margin: -2px 0 8px; }
  .chips .tag { font-size: 10px; padding: 2px 6px; }
  .filters { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 10px; margin-bottom: 18px; }
  .filters select { height: 36px; padding: 0 8px; border: 1px solid var(--navy-15); border-radius: 2px; background: #fff; font-size: 14px; }
  .filters select.on { border-color: var(--navy); font-weight: 600; }
</style>

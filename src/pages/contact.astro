---
import Base from '../layouts/Base.astro';
import { SITE } from '../site';

const social = SITE.social.filter((s) => s.href);
---

<Base title="Contact" description="Pitch a guest for Built West, or get in touch.">
  <section class="page-hero">
    <div class="wrap">
      <p class="eyebrow">Contact</p>
      <h1 class="h1">Get in touch.</h1>
      <p class="lede">Know someone who should be on the show? Tell us about them. For anything else, pick the other tab.</p>
    </div>
  </section>

  <section class="section section--flush-top">
    <div class="wrap layout">
      <div>
        <div class="seg" role="tablist" aria-label="What’s this about?">
          <button type="button" role="tab" id="tab-pitch" aria-controls="panel-pitch" aria-selected="true">Pitch a guest</button>
          <button type="button" role="tab" id="tab-general" aria-controls="panel-general" aria-selected="false" tabindex="-1">Something else</button>
        </div>

        <div id="panel-pitch" role="tabpanel" aria-labelledby="tab-pitch">
          <form name="pitch" method="POST" action="/thanks/" data-netlify="true" netlify-honeypot="bot-field" data-ajax data-success="<strong>Thanks.</strong> We read every one.">
            <input type="hidden" name="form-name" value="pitch" />
            <p class="hp" aria-hidden="true"><label>Leave this empty <input name="bot-field" tabindex="-1" autocomplete="off" /></label></p>
            <div class="two">
              <div class="field"><label for="p-name">Your name</label><input id="p-name" name="name" required autocomplete="name" /></div>
              <div class="field"><label for="p-email">Your email</label><input id="p-email" name="email" type="email" required autocomplete="email" /></div>
            </div>
            <div class="two">
              <div class="field"><label for="p-guest">Guest name</label><input id="p-guest" name="guest" required /></div>
              <div class="field"><label for="p-role">Role and company</label><input id="p-role" name="guest_role" /></div>
            </div>
            <div class="field"><label for="p-why">Why are they worth an hour?</label><textarea id="p-why" name="why" required></textarea></div>
            <div class="field"><label for="p-link">Link (optional)</label><input id="p-link" name="link" type="url" placeholder="LinkedIn, website or article" /></div>
            <button class="btn" type="submit">Send pitch <span class="arrow" aria-hidden="true"></span></button>
            <p class="form-error" role="alert" hidden>That didn’t go through. Please try again, or email {SITE.email}.</p>
          </form>
        </div>

        <div id="panel-general" role="tabpanel" aria-labelledby="tab-general" hidden>
          <form name="contact" method="POST" action="/thanks/" data-netlify="true" netlify-honeypot="bot-field" data-ajax data-success="<strong>Thanks.</strong> We’ll be in touch.">
            <input type="hidden" name="form-name" value="contact" />
            <p class="hp" aria-hidden="true"><label>Leave this empty <input name="bot-field" tabindex="-1" autocomplete="off" /></label></p>
            <div class="two">
              <div class="field"><label for="g-name">Your name</label><input id="g-name" name="name" required autocomplete="name" /></div>
              <div class="field"><label for="g-email">Your email</label><input id="g-email" name="email" type="email" required autocomplete="email" /></div>
            </div>
            <div class="field"><label for="g-message">Message</label><textarea id="g-message" name="message" required></textarea></div>
            <button class="btn" type="submit">Send message <span class="arrow" aria-hidden="true"></span></button>
            <p class="form-error" role="alert" hidden>That didn’t go through. Please try again, or email {SITE.email}.</p>
          </form>
        </div>
      </div>

      <aside>
        <div class="card">
          <p class="eyebrow eyebrow--muted">Press and general enquiries</p>
          <p class="direct"><a class="link" href={`mailto:${SITE.email}`}>{SITE.email}</a></p>
          {social.length > 0 && (
            <>
              <p class="eyebrow eyebrow--muted">Follow</p>
              <div class="pills">{social.map((s) => <a class="pill" href={s.href}>{s.label}</a>)}</div>
            </>
          )}
        </div>
      </aside>
    </div>
  </section>
</Base>

<script>
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('.seg [role="tab"]')];
  const select = (tab: HTMLButtonElement) => {
    tabs.forEach((t) => {
      const on = t === tab;
      t.setAttribute('aria-selected', String(on));
      t.tabIndex = on ? 0 : -1;
      document.getElementById(t.getAttribute('aria-controls')!)!.hidden = !on;
    });
  };
  tabs.forEach((t, i) => {
    t.addEventListener('click', () => select(t));
    t.addEventListener('keydown', (e) => {
      if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
      const next = tabs[(i + (e.key === 'ArrowRight' ? 1 : tabs.length - 1)) % tabs.length];
      select(next);
      next.focus();
    });
  });
</script>

<style>
  .page-hero { padding: clamp(64px, 9vw, 120px) 0 clamp(40px, 5vw, 72px); }
  .page-hero h1 { margin: 20px 0 24px; }
  .page-hero .lede { max-width: 60ch; }

  .layout { display: grid; grid-template-columns: 7fr 4fr; gap: 80px; }
  .seg { display: inline-flex; border: 1px solid var(--navy); border-radius: 2px; margin-bottom: 40px; }
  .seg button {
    height: 44px; padding: 0 20px; border: 0; background: transparent; cursor: pointer;
    font: 600 12px var(--font-sans); letter-spacing: 0.14em; text-transform: uppercase;
  }
  .seg button[aria-selected='true'] { background: var(--navy); color: var(--white); }
  .two { display: grid; grid-template-columns: 1fr 1fr; gap: 28px; }
  .direct { margin: 12px 0 24px; }
  .card .pills { margin-top: 12px; }
  .card .micro { margin-top: 28px; }

  @media (max-width: 959px) {
    .layout, .two { grid-template-columns: 1fr; gap: 0 28px; }
    aside { margin-top: 48px; }
  }
</style>

---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src?: ImageMetadata;
  alt: string;
  label?: string;
  eager?: boolean;
}
const { src, alt, label = 'Guest portrait', eager = false } = Astro.props;
---

{src ? (
  <Image class="portrait" src={src} alt={alt} widths={[400, 640, 960]} sizes="(min-width: 960px) 400px, 100vw" loading={eager ? 'eager' : 'lazy'} />
) : (
  <div class="portrait portrait--placeholder" role="img" aria-label={alt}>{label}</div>
)}

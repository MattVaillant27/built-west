---
// Email signup, handled by Netlify Forms ("notify"); netlify/functions/submission-created.mjs passes it to Kit. Place inside a .navy/.forest section for the dark variant.
interface Props {
  id: string;
  button?: string;
  dark?: boolean;
}
import { SITE } from '../site';

const { id, button = 'Get notified', dark = false } = Astro.props;
---

<div class:list={['signup', { dark }]}>
  <form
    id={id}
    name="notify"
    method="POST"
    action="/thanks/"
    data-netlify="true"
    netlify-honeypot="bot-field"
    data-ajax
    data-success="<strong>Almost there.</strong> Check your inbox to confirm your email."
  >
    <input type="hidden" name="form-name" value="notify" />
    <p class="hp" aria-hidden="true"><label>Leave this empty <input name="bot-field" tabindex="-1" autocomplete="off" /></label></p>
    <div class="row">
      <label class="sr-only" for={`${id}-email`}>Email address</label>
      <input id={`${id}-email`} type="email" name="email" required autocomplete="email" placeholder="you@company.com" />
      <button class:list={['btn', { 'btn--inv': dark }]} type="submit">
        {button} <span class="arrow" aria-hidden="true"></span>
      </button>
    </div>
    <p class="consent">Occasional emails from {SITE.legalName} Unsubscribe anytime. <a href="/privacy/">Privacy</a></p>
    <p class="form-error" role="alert" hidden>That didn’t go through. Check your email address and try again.</p>
  </form>
</div>

<style>
  .signup { max-width: 540px; }
  .row { display: flex; gap: 12px; }
  input[type='email'] {
    flex: 1; min-width: 0; height: 48px; padding: 0 2px;
    background: transparent; border: 0; border-bottom: 1.5px solid var(--navy); border-radius: 0;
    font-size: 16px;
  }
  input[type='email']::placeholder { color: var(--coastal); }
  .dark input[type='email'] { border-bottom-color: var(--white); }
  .dark input[type='email']::placeholder { color: rgba(255, 255, 255, 0.55); }
  .consent { font-size: 13px; color: var(--coastal); margin-top: 12px; }
  .consent a { text-underline-offset: 3px; }
  .dark .consent { color: var(--white-70); }
  .signup :global(.form-success) { margin-top: 8px; }
  @media (max-width: 639px) {
    .row { flex-direction: column; }
    .row .btn { width: 100%; }
  }
</style>

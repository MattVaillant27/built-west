---
import logoStacked from '../assets/brand/logo-stacked-navy.svg';
import SignupForm from './SignupForm.astro';
import { SITE } from '../site';

const social = SITE.social.filter((s) => s.href);
const year = new Date().getFullYear();
---

<footer class="navy site-footer">
  <div class="wrap">
    <div class="top">
      <div>
        <img class="logo" src={logoStacked.src} width="460" height="330" alt="Built West — A BC Tech Podcast" />
        <p class="serif tag">The people building BC tech.</p>
      </div>
      <nav aria-label="Footer">
        <p class="eyebrow">Explore</p>
        <ul>
          <li><a href="/episodes/">Episodes</a></li>
          <li><a href="/about/">About</a></li>
          <li><a href="/contact/">Pitch a guest</a></li>
          <li><a href="/contact/">Contact</a></li>
        </ul>
      </nav>
      {social.length > 0 && (
        <nav aria-label="Follow Built West">
          <p class="eyebrow">Follow</p>
          <ul>{social.map((s) => <li><a href={s.href} rel="me noopener">{s.label}</a></li>)}</ul>
        </nav>
      )}
      <div>
        <p class="eyebrow">Get notified</p>
        <SignupForm id="signup-footer" button="Join" dark note={false} />
      </div>
    </div>
    <div class="bottom">
      <span>© {year} {SITE.name}</span>
    </div>
  </div>
</footer>

<style>
  .site-footer { padding: 72px 0 32px; font-size: 14px; }
  .top { display: grid; grid-template-columns: 4fr 2fr 2fr 4fr; gap: 48px; padding-bottom: 48px; border-bottom: 1px solid var(--white-15); }
  .logo { width: 180px; margin: -12px 0 16px -14px; }
  .tag { font-size: 22px; line-height: 1.3; font-weight: 600; max-width: 22ch; }
  .eyebrow { margin-bottom: 18px; }
  ul { list-style: none; padding: 0; }
  nav li { margin-bottom: 10px; }
  a { text-decoration: none; }
  a:hover { text-decoration: underline; text-decoration-color: var(--orange); text-underline-offset: 4px; }
  .bottom { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12px 32px; padding-top: 24px; color: var(--white-70); }
  @media (max-width: 959px) {
    .top { grid-template-columns: 1fr 1fr; gap: 40px; }
    .top > div { grid-column: 1 / -1; }
  }
</style>
